rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId); }
    function matchPath(roomId, matchId) { return /databases/$(database)/documents/rooms/$(roomId)/matches/$(matchId); }
    function playerPath(roomId, playerId) { return /databases/$(database)/documents/rooms/$(roomId)/players/$(playerId); }
    function seriesPath(roomId, seriesId) { return /databases/$(database)/documents/rooms/$(roomId)/series/$(seriesId); }
    function room(roomId) { return get(roomPath(roomId)); }
    function isMember(roomId) { return signedIn() && room(roomId).data.memberIds.hasAny([request.auth.uid]); }
    function isHost(roomId) { return signedIn() && room(roomId).data.hostId == request.auth.uid; }
    function validServerTime(field) { return field == request.time; }
    function validBoard(board) { return board is list && board.size() == 9 && board.toSet().hasOnly([null, 'X', 'O']); }
    function hasLine(board, mark) {
      return (board[0] == mark && board[1] == mark && board[2] == mark)
        || (board[3] == mark && board[4] == mark && board[5] == mark)
        || (board[6] == mark && board[7] == mark && board[8] == mark)
        || (board[0] == mark && board[3] == mark && board[6] == mark)
        || (board[1] == mark && board[4] == mark && board[7] == mark)
        || (board[2] == mark && board[5] == mark && board[8] == mark)
        || (board[0] == mark && board[4] == mark && board[8] == mark)
        || (board[2] == mark && board[4] == mark && board[6] == mark);
    }
    function changedBoardCells(before, after) {
      return (before[0] != after[0] ? 1 : 0) + (before[1] != after[1] ? 1 : 0)
        + (before[2] != after[2] ? 1 : 0) + (before[3] != after[3] ? 1 : 0)
        + (before[4] != after[4] ? 1 : 0) + (before[5] != after[5] ? 1 : 0)
        + (before[6] != after[6] ? 1 : 0) + (before[7] != after[7] ? 1 : 0)
        + (before[8] != after[8] ? 1 : 0);
    }
    function validCellChange(before, after, turn) { return before == after || (before == null && after == turn); }
    function validMoveBoard(before, after, turn) {
      return changedBoardCells(before, after) == 1
        && validCellChange(before[0], after[0], turn) && validCellChange(before[1], after[1], turn)
        && validCellChange(before[2], after[2], turn) && validCellChange(before[3], after[3], turn)
        && validCellChange(before[4], after[4], turn) && validCellChange(before[5], after[5], turn)
        && validCellChange(before[6], after[6], turn) && validCellChange(before[7], after[7], turn)
        && validCellChange(before[8], after[8], turn);
    }
    function validResult(after) {
      return (after.status == 'playing' && after.winner == null && after.winningLine.size() == 0 && after.moveCount < 9)
        || (after.status == 'won' && after.winner in ['X', 'O']
          && after.winningLine is list && after.winningLine.size() == 3 && hasLine(after.board, after.winner))
        || (after.status == 'draw' && after.winner == null && after.winningLine.size() == 0
          && after.moveCount == 9 && !hasLine(after.board, 'X') && !hasLine(after.board, 'O'));
    }
    function scoreDelta(roomId, playerId, beforeMatch, afterMatch) {
      let beforeScore = get(playerPath(roomId, playerId)).data.partyScore;
      let afterScore = getAfter(playerPath(roomId, playerId)).data.partyScore;
      let mark = playerId == beforeMatch.playerX ? 'X' : 'O';
      let expected = afterMatch.status == 'draw' ? 1 : afterMatch.winner == mark ? 3 : 0;
      return afterScore == beforeScore + expected;
    }
    function validScoreSettlement(roomId, beforeMatch, afterMatch) {
      return scoreDelta(roomId, beforeMatch.playerX, beforeMatch, afterMatch)
        && scoreDelta(roomId, beforeMatch.playerO, beforeMatch, afterMatch);
    }
    function validSeriesSettlement(roomId, beforeSeries, afterSeries) {
      let beforeMatch = get(matchPath(roomId, room(roomId).data.currentMatchId)).data;
      let afterMatch = getAfter(matchPath(roomId, room(roomId).data.currentMatchId)).data;
      let winningId = afterMatch.status == 'won' ? (afterMatch.winner == 'X' ? beforeMatch.playerX : beforeMatch.playerO) : null;
      return afterSeries.winsByPlayer[beforeSeries.playerA] == beforeSeries.winsByPlayer[beforeSeries.playerA] + (winningId == beforeSeries.playerA ? 1 : 0)
        && afterSeries.winsByPlayer[beforeSeries.playerB] == beforeSeries.winsByPlayer[beforeSeries.playerB] + (winningId == beforeSeries.playerB ? 1 : 0);
    }
    function validSeriesResult(series) {
      return (series.status == 'playing' && series.winnerId == null && series.roundsPlayed < series.maxRounds
          && series.winsByPlayer[series.playerA] < series.targetWins && series.winsByPlayer[series.playerB] < series.targetWins)
        || (series.status == 'won' && series.winnerId in [series.playerA, series.playerB]
          && (series.winsByPlayer[series.winnerId] >= series.targetWins
            || (series.roundsPlayed == series.maxRounds
              && series.winsByPlayer[series.winnerId] > series.winsByPlayer[series.winnerId == series.playerA ? series.playerB : series.playerA])))
        || (series.status == 'draw' && series.winnerId == null && series.roundsPlayed == series.maxRounds
          && series.winsByPlayer[series.playerA] == series.winsByPlayer[series.playerB]);
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hostId','roomCode','status','currentMatchId','currentSeriesId','roundNumber','seriesNumber','gameVersion','schemaVersion','createdAt','updatedAt','expiresAt','settings','memberIds','memberCount','playerCount','spectatorCount','activePlayerCount','usedEmojis'])
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.roomCode is string && request.resource.data.roomCode.size() == 5
        && request.resource.data.status == 'lobby' && request.resource.data.currentMatchId == null && request.resource.data.currentSeriesId == null && request.resource.data.roundNumber == -1 && request.resource.data.seriesNumber == -1
        && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.memberCount == 1 && request.resource.data.playerCount == 1 && request.resource.data.spectatorCount == 0 && request.resource.data.activePlayerCount == 1
        && request.resource.data.usedEmojis is list && request.resource.data.usedEmojis.size() == 1
        && validServerTime(request.resource.data.createdAt) && validServerTime(request.resource.data.updatedAt)
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.settings.maxMembers == 8
        && request.resource.data.settings.maxPlayers is int && request.resource.data.settings.maxPlayers >= 2 && request.resource.data.settings.maxPlayers <= 8
        && request.resource.data.settings.maxActivePlayers is int && request.resource.data.settings.maxActivePlayers >= 2 && request.resource.data.settings.maxActivePlayers <= 8
        && request.resource.data.settings.seriesTargetWins in [1,2,3]
        && request.resource.data.settings.maxSeriesRounds in [1,5,9];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) ? (
          signedIn() && validServerTime(request.resource.data.updatedAt)
          && ((resource.data.status == 'playing' && resource.data.currentMatchId != null
              && request.auth.uid == (get(matchPath(roomId, resource.data.currentMatchId)).data.currentTurn == 'X' ? get(matchPath(roomId, resource.data.currentMatchId)).data.playerX : get(matchPath(roomId, resource.data.currentMatchId)).data.playerO)
              && request.resource.data.status in ['roundOver','seriesBreak']
              && getAfter(matchPath(roomId, resource.data.currentMatchId)).data.status in ['won','draw']
              && getAfter(matchPath(roomId, resource.data.currentMatchId)).data.scoreApplied == true
              && (!resource.data.keys().hasAny(['currentSeriesId']) ||
                (request.resource.data.status == 'roundOver' ? getAfter(seriesPath(roomId, resource.data.currentSeriesId)).data.status == 'playing' : getAfter(seriesPath(roomId, resource.data.currentSeriesId)).data.status in ['won','draw'])))
            || (isHost(roomId) && resource.data.status in ['seriesOver','seriesBreak'] && request.resource.data.status == 'partyOver'))
        ) : request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds']) ? (
          signedIn() && !resource.data.memberIds.hasAny([request.auth.uid])
            && resource.data.memberCount < (resource.data.settings.keys().hasAny(['maxMembers']) ? resource.data.settings.maxMembers : resource.data.settings.maxPlayers)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','memberCount','playerCount','spectatorCount','activePlayerCount','usedEmojis','updatedAt'])
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && request.resource.data.playerCount + request.resource.data.spectatorCount == request.resource.data.memberCount
            && request.resource.data.activePlayerCount == request.resource.data.playerCount
            && ((resource.data.status == 'lobby'
                && ((request.resource.data.playerCount == resource.data.playerCount + 1 && request.resource.data.spectatorCount == resource.data.spectatorCount)
                  || (request.resource.data.playerCount == resource.data.playerCount && request.resource.data.spectatorCount == resource.data.spectatorCount + 1)))
              || (resource.data.status != 'lobby' && request.resource.data.playerCount == resource.data.playerCount && request.resource.data.spectatorCount == resource.data.spectatorCount + 1))
            && request.resource.data.playerCount <= resource.data.settings.maxActivePlayers
            && validServerTime(request.resource.data.updatedAt)
        ) : request.resource.data.diff(resource.data).affectedKeys().hasAny(['playerCount','spectatorCount']) ? (
            isMember(roomId) && resource.data.status in ['lobby','seriesBreak','seriesOver']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount','spectatorCount','activePlayerCount','updatedAt'])
            && request.resource.data.playerCount + request.resource.data.spectatorCount == resource.data.memberCount
            && request.resource.data.activePlayerCount == request.resource.data.playerCount
            && request.resource.data.playerCount >= 0 && request.resource.data.playerCount <= resource.data.settings.maxActivePlayers
            && ((request.resource.data.playerCount == resource.data.playerCount + 1 && request.resource.data.spectatorCount == resource.data.spectatorCount - 1)
              || (request.resource.data.playerCount == resource.data.playerCount - 1 && request.resource.data.spectatorCount == resource.data.spectatorCount + 1)
              || (request.resource.data.playerCount == resource.data.playerCount && request.resource.data.spectatorCount == resource.data.spectatorCount))
            && validServerTime(request.resource.data.updatedAt)
        ) : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings','updatedAt']) ? (
          isHost(roomId) && resource.data.status == 'lobby' && request.resource.data.status == 'lobby'
          && request.resource.data.settings.diff(resource.data.settings).affectedKeys().hasOnly(['seriesTargetWins','maxSeriesRounds'])
          && request.resource.data.settings.seriesTargetWins in [1,2,3]
          && request.resource.data.settings.maxSeriesRounds == (request.resource.data.settings.seriesTargetWins == 1 ? 1 : request.resource.data.settings.seriesTargetWins == 2 ? 5 : 9)
          && validServerTime(request.resource.data.updatedAt)
        ) : (
          isHost(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','currentMatchId','currentSeriesId','roundNumber','seriesNumber','updatedAt'])
          && validServerTime(request.resource.data.updatedAt)
          && ((resource.data.status == 'lobby' && request.resource.data.status == 'playing' && request.resource.data.roundNumber == 0 && request.resource.data.seriesNumber == 0)
            || (resource.data.status == 'roundOver' && request.resource.data.status == 'playing' && request.resource.data.roundNumber == resource.data.roundNumber + 1)
            || (resource.data.status in ['seriesOver','seriesBreak'] && request.resource.data.status == 'playing' && request.resource.data.roundNumber == resource.data.roundNumber + 1 && request.resource.data.seriesNumber == resource.data.seriesNumber + 1))
          && request.resource.data.currentMatchId != resource.data.currentMatchId && request.resource.data.currentSeriesId != null
        );

      match /players/{playerId} {
        allow read: if isMember(roomId);
        allow create: if signedIn() && playerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['playerId','emoji','seat','role','requestedRole','joinedDuringSeries','partyScore','joinedAt','lastSeenAt','roleUpdatedAt','status'])
          && request.resource.data.playerId == request.auth.uid
          && getAfter(roomPath(roomId)).data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.seat == getAfter(roomPath(roomId)).data.memberCount - 1
          && getAfter(roomPath(roomId)).data.usedEmojis.hasAny([request.resource.data.emoji])
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && request.resource.data.seat is int && request.resource.data.seat >= 0 && request.resource.data.seat < 8
          && request.resource.data.partyScore == 0
          && request.resource.data.role in ['player','spectator']
          && request.resource.data.requestedRole == null
          && request.resource.data.joinedDuringSeries == (getAfter(roomPath(roomId)).data.status != 'lobby')
          && (getAfter(roomPath(roomId)).data.status == 'lobby' || request.resource.data.role == 'spectator')
          && (request.resource.data.seat == 0 ? request.resource.data.role == 'player' :
            (request.resource.data.role == 'player'
              ? getAfter(roomPath(roomId)).data.playerCount == room(roomId).data.playerCount + 1
              : getAfter(roomPath(roomId)).data.spectatorCount == room(roomId).data.spectatorCount + 1))
          && validServerTime(request.resource.data.joinedAt) && validServerTime(request.resource.data.lastSeenAt) && validServerTime(request.resource.data.roleUpdatedAt)
          && request.resource.data.status in ['active','away'];
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partyScore']) ? (
            isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentMatchId != null
            && get(matchPath(roomId, room(roomId).data.currentMatchId)).data.scoreApplied == false
            && getAfter(matchPath(roomId, room(roomId).data.currentMatchId)).data.scoreApplied == true
            && playerId in [get(matchPath(roomId, room(roomId).data.currentMatchId)).data.playerX, get(matchPath(roomId, room(roomId).data.currentMatchId)).data.playerO]
          ) : request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ? (
            signedIn() && resource.data.playerId == playerId && room(roomId).data.status in ['lobby','seriesBreak','seriesOver']
            && (request.auth.uid == playerId || isHost(roomId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','requestedRole','joinedDuringSeries','roleUpdatedAt','lastSeenAt'])
            && request.resource.data.role in ['player','spectator']
            && request.resource.data.requestedRole == null
            && request.resource.data.joinedDuringSeries == false
            && getAfter(roomPath(roomId)).data.playerCount == room(roomId).data.playerCount + (request.resource.data.role == 'player' ? 1 : 0) - (resource.data.role == 'spectator' ? 0 : 1)
            && getAfter(roomPath(roomId)).data.spectatorCount == room(roomId).data.spectatorCount + (request.resource.data.role == 'spectator' ? 1 : 0) - (resource.data.role == 'spectator' ? 1 : 0)
            && validServerTime(request.resource.data.roleUpdatedAt) && validServerTime(request.resource.data.lastSeenAt)
          ) : request.resource.data.diff(resource.data).affectedKeys().hasAny(['requestedRole']) ? (
            signedIn() && playerId == request.auth.uid && room(roomId).data.status == 'seriesBreak'
            && resource.data.role == 'spectator'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestedRole','roleUpdatedAt','lastSeenAt'])
            && request.resource.data.requestedRole in ['player', null]
            && validServerTime(request.resource.data.roleUpdatedAt) && validServerTime(request.resource.data.lastSeenAt)
          ) : (
            signedIn() && playerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt','status'])
            && validServerTime(request.resource.data.lastSeenAt)
            && request.resource.data.status in ['active','away']
          );
        allow delete: if false;
      }

      match /matches/{matchId} {
        allow read: if isMember(roomId);
        allow create: if isHost(roomId)
          && request.resource.data.keys().hasOnly(['gameType','playerX','playerO','board','currentTurn','status','winner','winningLine','moveCount','scoreApplied','roundNumber','seriesId','seriesRoundNumber','suggestionsMutedMoveCount','createdAt','updatedAt'])
          && request.resource.data.gameType == 'tic-tac-toe' && validBoard(request.resource.data.board)
          && request.resource.data.playerX != request.resource.data.playerO
          && room(roomId).data.memberIds.hasAny([request.resource.data.playerX])
          && room(roomId).data.memberIds.hasAny([request.resource.data.playerO])
          && request.resource.data.moveCount == 0 && request.resource.data.currentTurn == 'X'
          && request.resource.data.status == 'playing' && request.resource.data.winner == null
          && request.resource.data.winningLine.size() == 0 && request.resource.data.scoreApplied == false && request.resource.data.suggestionsMutedMoveCount == -1
          && request.resource.data.seriesId == getAfter(roomPath(roomId)).data.currentSeriesId
          && getAfter(roomPath(roomId)).data.currentMatchId == matchId
          && getAfter(roomPath(roomId)).data.status == 'playing'
          && getAfter(roomPath(roomId)).data.roundNumber == request.resource.data.roundNumber
          && validServerTime(request.resource.data.createdAt) && validServerTime(request.resource.data.updatedAt);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreApplied','updatedAt']) ? (
            isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentMatchId == matchId
            && resource.data.status in ['won','draw'] && resource.data.scoreApplied == false && request.resource.data.scoreApplied == true
            && request.auth.uid == (resource.data.currentTurn == 'X' ? resource.data.playerX : resource.data.playerO)
            && getAfter(roomPath(roomId)).data.status in ['roundOver','seriesBreak']
            && validScoreSettlement(roomId, resource.data, request.resource.data)
            && validServerTime(request.resource.data.updatedAt)
          ) : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suggestionsMutedMoveCount','updatedAt']) ? (
            isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentMatchId == matchId
            && resource.data.status == 'playing'
            && request.auth.uid == (resource.data.currentTurn == 'X' ? resource.data.playerX : resource.data.playerO)
            && request.resource.data.suggestionsMutedMoveCount == resource.data.moveCount
            && validServerTime(request.resource.data.updatedAt)
          ) : (
            isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentMatchId == matchId
            && resource.data.status == 'playing' && resource.data.scoreApplied == false && request.resource.data.scoreApplied == false
            && request.auth.uid == (resource.data.currentTurn == 'X' ? resource.data.playerX : resource.data.playerO)
            && (!get(playerPath(roomId, request.auth.uid)).data.keys().hasAny(['role']) || get(playerPath(roomId, request.auth.uid)).data.role == 'player')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board','currentTurn','status','winner','winningLine','moveCount','updatedAt'])
            && validBoard(request.resource.data.board) && validMoveBoard(resource.data.board, request.resource.data.board, resource.data.currentTurn)
            && request.resource.data.moveCount == resource.data.moveCount + 1 && validResult(request.resource.data)
            && (request.resource.data.status == 'playing' ? request.resource.data.currentTurn != resource.data.currentTurn : request.resource.data.currentTurn == resource.data.currentTurn)
            && validServerTime(request.resource.data.updatedAt)
          );
        allow delete: if false;

        match /suggestions/{spectatorId} {
          allow read: if isMember(roomId);
          allow create, update: if isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentMatchId == matchId
            && (
              request.auth.uid == spectatorId
              && get(playerPath(roomId, request.auth.uid)).data.role == 'spectator'
              && request.resource.data.spectatorId == request.auth.uid
              && request.resource.data.suggestedCell is int && request.resource.data.suggestedCell >= 0 && request.resource.data.suggestedCell <= 8
              && request.resource.data.moveCount == get(matchPath(roomId, matchId)).data.moveCount
              && get(matchPath(roomId, matchId)).data.board[request.resource.data.suggestedCell] == null
              && request.resource.data.status == 'pending'
              && request.resource.data.resolvedAt == null && request.resource.data.resolvedBy == null
            ) || (
              request.auth.uid == (get(matchPath(roomId, matchId)).data.currentTurn == 'X' ? get(matchPath(roomId, matchId)).data.playerX : get(matchPath(roomId, matchId)).data.playerO)
              && resource.data.status == 'pending' && resource.data.moveCount == get(matchPath(roomId, matchId)).data.moveCount
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','resolvedBy'])
              && request.resource.data.status in ['accepted','dismissed'] && request.resource.data.resolvedBy == request.auth.uid
              && validServerTime(request.resource.data.resolvedAt)
            );
          allow delete: if false;
        }
      }

      match /series/{seriesId} {
        allow read: if isMember(roomId);
        allow create: if isHost(roomId)
          && request.resource.data.keys().hasOnly(['playerA','playerB','winsByPlayer','roundsPlayed','targetWins','maxRounds','status','winnerId','pairingRoundNumber','createdAt','updatedAt'])
          && request.resource.data.playerA != request.resource.data.playerB
          && (!get(playerPath(roomId, request.resource.data.playerA)).data.keys().hasAny(['role']) || get(playerPath(roomId, request.resource.data.playerA)).data.role == 'player')
          && (!get(playerPath(roomId, request.resource.data.playerB)).data.keys().hasAny(['role']) || get(playerPath(roomId, request.resource.data.playerB)).data.role == 'player')
          && request.resource.data.targetWins in [1,2,3] && request.resource.data.maxRounds in [1,5,9]
          && request.resource.data.roundsPlayed == 0 && request.resource.data.status == 'playing' && request.resource.data.winnerId == null
          && request.resource.data.winsByPlayer[request.resource.data.playerA] == 0 && request.resource.data.winsByPlayer[request.resource.data.playerB] == 0
          && getAfter(roomPath(roomId)).data.currentSeriesId == seriesId
          && validServerTime(request.resource.data.createdAt) && validServerTime(request.resource.data.updatedAt);
        allow update: if isMember(roomId) && room(roomId).data.status == 'playing' && room(roomId).data.currentSeriesId == seriesId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['winsByPlayer','roundsPlayed','status','winnerId','updatedAt'])
          && request.resource.data.roundsPlayed == resource.data.roundsPlayed + 1
          && request.resource.data.status in ['playing','won','draw']
          && validSeriesSettlement(roomId, resource.data, request.resource.data)
          && validSeriesResult(request.resource.data)
          && validServerTime(request.resource.data.updatedAt);
        allow delete: if false;
      }
    }

    match /roomCodes/{roomCode} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && roomCode.size() == 5
        && request.resource.data.keys().hasOnly(['roomId','expiresAt'])
        && request.resource.data.roomId is string && request.resource.data.expiresAt > request.time;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
