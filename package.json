{
  "name": "cyber-table",
  "version": "0.4.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:rules": "firebase emulators:exec --project cyber-table-local --only firestore \"node --test tests/firestore.rules.test.js\"",
    "test:emulator": "firebase emulators:exec --project cyber-table-local --only auth,firestore \"node --test tests/firebase-room-service.test.js\"",
    "test:version": "node --test tests/version.test.js",
    "check:version": "node scripts/check-version.js",
    "check:release": "node scripts/check-release.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.27.0"
  }
}
